{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/jogar", "destination": "/jogar.html" },
    { "source": "/ranking", "destination": "/ranking.html" },
    { "source": "/colecao", "destination": "/colecao.html" },
    { "source": "/vozes", "destination": "/vozes.html" },
    { "source": "/teste", "destination": "/teste.html" },
    { "source": "/hangar", "destination": "/hangar.html" },
    { "source": "/passaporte", "destination": "/passaporte.html" },
    { "source": "/sobre", "destination": "/sobre.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
